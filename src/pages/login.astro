---
export const prerender = true;

import "@fontsource-variable/outfit";
import "@fontsource-variable/lexend";
import "@/styles/app.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Sign in — Portfolio Builder</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-cream font-body text-ink">
    <a href="#login-form" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-amber focus:px-4 focus:py-2 focus:text-ink focus:shadow-overlay">
      Skip to content
    </a>
    <main id="login-form" class="w-full max-w-sm px-6">
      <div class="text-center">
        <a href="/" class="inline-flex items-center gap-2">
          <div class="flex h-8 w-8 items-center justify-center rounded-md bg-amber/15">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="currentColor" class="text-amber-dim">
              <path opacity="0.2" d="M128,32a96,96,0,1,0,96,96A96,96,0,0,0,128,32ZM80,176l17.37-69.47L167,80Z"/>
              <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216ZM172.42,72.84l-64,32a8.05,8.05,0,0,0-3.58,3.58l-32,64A8,8,0,0,0,80,184a8.1,8.1,0,0,0,3.58-.84l64-32a8.05,8.05,0,0,0,3.58-3.58l32-64a8,8,0,0,0-10.74-10.74ZM138,138,97.89,158.11,118,118l40.15-20.07Z"/>
            </svg>
          </div>
          <span class="font-display text-lg font-bold tracking-tight">Portfolio Builder</span>
        </a>
      </div>

      <div class="mt-10 rounded-xl border border-ash bg-stone/50 p-8">
        <h1 class="font-display text-xl font-bold tracking-tight">Sign in</h1>
        <p class="mt-2 text-sm text-graphite">
          Authentication is coming soon. For now, head straight to the dashboard.
        </p>

        <div class="mt-8 space-y-3">
          <!-- Placeholder: Google OAuth button (disabled until auth is wired up) -->
          <button
            disabled
            class="flex w-full items-center justify-center gap-2 rounded-lg border border-ash bg-cream px-4 py-2.5 text-sm font-medium text-graphite opacity-50 cursor-not-allowed"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="currentColor">
              <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,16a88.09,88.09,0,0,1,87.8,83.52H128.79L98.5,71.19A87.38,87.38,0,0,1,128,40ZM40,128a87.43,87.43,0,0,1,43-75.19L113.28,128,83,203.19A87.43,87.43,0,0,1,40,128Zm88,88a87.38,87.38,0,0,1-29.5-5.19l30.29-52.33h87A88.09,88.09,0,0,1,128,216Z"/>
            </svg>
            Sign in with Google
          </button>

          <!-- Dev bypass: skip straight to dashboard -->
          <a
            href="/dashboard"
            class="flex w-full items-center justify-center rounded-lg bg-amber px-4 py-2.5 text-sm font-medium text-ink transition-all duration-300 hover:-translate-y-0.5 hover:shadow-hover"
          >
            Skip to Dashboard
          </a>
        </div>
      </div>

      <p class="mt-6 text-center text-xs text-graphite">
        By continuing, you agree to our
        <a href="/terms" class="underline transition-colors hover:text-ink">Terms</a>
        and
        <a href="/privacy" class="underline transition-colors hover:text-ink">Privacy Policy</a>.
      </p>
    </main>
  </body>
</html>
