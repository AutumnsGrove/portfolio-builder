---
/**
 * Dashboard — Portfolio overview, user profile, custom instructions.
 *
 * Server-rendered from D1. Protected by middleware (redirects to / if not signed in).
 * Interactive bits (version dropdown, custom instructions) are Svelte islands.
 */

import { env } from "cloudflare:workers";
import "@fontsource-variable/outfit";
import "@fontsource-variable/lexend";
import "@/styles/app.css";
import PortfolioCard from "@/components/dashboard/PortfolioCard.svelte";
import CustomInstructions from "@/components/dashboard/CustomInstructions.svelte";

const db = (env as Env).DB;
const user = Astro.locals.user;

// When auth is bypassed, provide a dev-mode fallback identity
const displayUser = user ?? { id: "dev", name: "Developer", email: "dev@localhost", customInstructions: "" };

// Fetch portfolios (empty array if no real user)
let sites: { id: string; name: string; slug: string; status: string; updated_at: number }[] = [];
const siteVersions: Record<string, { id: string; name: string; createdAt: string }[]> = {};

if (user) {
  const result = await db
    .prepare("SELECT id, name, slug, status, updated_at FROM sites WHERE user_id = ? ORDER BY updated_at DESC")
    .bind(user.id)
    .all<{ id: string; name: string; slug: string; status: string; updated_at: number }>();
  sites = result.results;

  const { results: allVersions } = await db
    .prepare(`
      SELECT v.id, v.site_id, v.name, v.created_at
      FROM versions v
      JOIN sites s ON v.site_id = s.id
      WHERE s.user_id = ?
      ORDER BY v.created_at DESC
    `)
    .bind(user.id)
    .all<{ id: string; site_id: string; name: string; created_at: number }>();

  for (const v of allVersions) {
    if (!siteVersions[v.site_id]) siteVersions[v.site_id] = [];
    if (siteVersions[v.site_id].length < 10) {
      siteVersions[v.site_id].push({
        id: v.id,
        name: v.name,
        createdAt: new Date(v.created_at).toLocaleDateString(),
      });
    }
  }
}

function formatRelativeTime(timestamp: number): string {
  const diff = Date.now() - timestamp;
  const minutes = Math.floor(diff / 60000);
  if (minutes < 1) return "Just now";
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  if (days < 7) return `${days}d ago`;
  return new Date(timestamp).toLocaleDateString();
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Dashboard — Portfolio Builder</title>
  </head>
  <body class="min-h-screen bg-cream font-body text-ink">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-amber focus:px-4 focus:py-2 focus:text-ink focus:shadow-overlay">
      Skip to content
    </a>

    <!-- Header -->
    <header class="border-b border-ash">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3">
        <a href="/" class="flex items-center gap-2">
          <div class="flex h-7 w-7 items-center justify-center rounded-md bg-amber/15">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 256 256" fill="currentColor" class="text-amber-dim">
              <path opacity="0.2" d="M128,32a96,96,0,1,0,96,96A96,96,0,0,0,128,32ZM80,176l17.37-69.47L167,80Z"/>
              <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216ZM172.42,72.84l-64,32a8.05,8.05,0,0,0-3.58,3.58l-32,64A8,8,0,0,0,80,184a8.1,8.1,0,0,0,3.58-.84l64-32a8.05,8.05,0,0,0,3.58-3.58l32-64a8,8,0,0,0-10.74-10.74ZM138,138,97.89,158.11,118,118l40.15-20.07Z"/>
            </svg>
          </div>
          <span class="font-display text-base font-bold tracking-tight">Portfolio Builder</span>
        </a>

        <div class="flex items-center gap-2.5">
          <span class="text-sm text-graphite">{displayUser.name || displayUser.email}</span>
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-ink text-cream">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 256 256" fill="currentColor">
              <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24ZM74.08,197.5a64,64,0,0,1,107.84,0,87.83,87.83,0,0,1-107.84,0ZM96,120a32,32,0,1,1,32,32A32,32,0,0,1,96,120Zm97.76,66.41a79.66,79.66,0,0,0-36.06-28.75,48,48,0,1,0-59.4,0,79.66,79.66,0,0,0-36.06,28.75,88,88,0,1,1,131.52,0Z"/>
            </svg>
          </div>
        </div>
      </div>
    </header>

    <!-- Main content -->
    <main id="main-content" class="mx-auto max-w-5xl px-6 pt-10 pb-16">
      <div class="grid gap-12 lg:grid-cols-[1fr_280px]">
        <!-- Portfolios section -->
        <div>
          <div class="flex items-end justify-between">
            <div>
              <h1 class="font-display text-2xl font-bold tracking-tight">Your Portfolios</h1>
              <p class="mt-1 text-sm text-graphite">{sites.length} {sites.length === 1 ? 'portfolio' : 'portfolios'}</p>
            </div>
            <a
              href="/builder/new"
              class="flex items-center gap-1.5 rounded-lg bg-amber px-4 py-2 text-sm font-medium text-ink transition-all duration-300 hover:-translate-y-0.5 hover:shadow-hover"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 256 256" fill="currentColor">
                <path d="M224,128a8,8,0,0,1-8,8H136v80a8,8,0,0,1-16,0V136H40a8,8,0,0,1,0-16h80V40a8,8,0,0,1,16,0v80h80A8,8,0,0,1,224,128Z"/>
              </svg>
              New Portfolio
            </a>
          </div>

          {sites.length === 0 ? (
            <div class="mt-10 rounded-xl border-2 border-dashed border-ash px-8 py-16 text-center">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-amber/10">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 256 256" fill="currentColor" class="text-amber-dim">
                  <path d="M224,128a8,8,0,0,1-8,8H136v80a8,8,0,0,1-16,0V136H40a8,8,0,0,1,0-16h80V40a8,8,0,0,1,16,0v80h80A8,8,0,0,1,224,128Z"/>
                </svg>
              </div>
              <h3 class="mt-5 font-display text-lg font-semibold">Ready when you are</h3>
              <p class="mx-auto mt-1.5 max-w-xs text-sm text-graphite">Create your first portfolio. The Guide will walk you through it step by step.</p>
            </div>
          ) : (
            <div class="mt-6 space-y-3">
              {sites.map((site) => {
                const status: 'draft' | 'published' = site.status === 'published' ? 'published' : 'draft';
                return (
                  <PortfolioCard
                    client:only="svelte"
                    id={site.id}
                    name={site.name}
                    slug={site.slug}
                    status={status}
                    updatedAt={formatRelativeTime(site.updated_at)}
                    versions={siteVersions[site.id] || []}
                  />
                );
              })}
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="space-y-8 lg:pt-12">
          <!-- Custom instructions -->
          <div>
            <CustomInstructions
              client:only="svelte"
              initialValue={displayUser.customInstructions || ''}
              userId={displayUser.id}
            />
          </div>

          <!-- Account info -->
          <div class="space-y-2 text-sm">
            <h2 class="font-display text-xs font-semibold uppercase tracking-wide text-graphite">Account</h2>
            <p class="text-ink">{displayUser.name || '—'}</p>
            <p class="text-graphite">{displayUser.email}</p>
          </div>
        </aside>
      </div>
    </main>
  </body>
</html>
