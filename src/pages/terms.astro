---
export const prerender = true;

import "@fontsource-variable/outfit";
import "@fontsource-variable/lexend";
import "@/styles/app.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Terms of Service — Portfolio Builder</title>
  </head>
  <body class="min-h-screen bg-cream font-body text-ink">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-amber focus:px-4 focus:py-2 focus:text-ink focus:shadow-overlay">
      Skip to content
    </a>
    <nav aria-label="Main navigation" class="mx-auto flex max-w-3xl items-center justify-between px-6 py-6">
      <a href="/" class="font-display text-lg font-semibold tracking-tight text-ink">
        Portfolio Builder
      </a>
      <a href="/login" class="text-sm text-graphite transition-colors hover:text-ink">
        Sign in
      </a>
    </nav>

    <main id="main-content" class="mx-auto max-w-3xl px-6 pb-16 pt-8">
      <h1 class="font-display text-3xl font-bold tracking-tight">Terms of Service</h1>
      <p class="mt-4 text-graphite">Last updated: May 2026</p>

      <div class="mt-10 space-y-8 text-graphite leading-relaxed">
        <section>
          <h2 class="font-display text-lg font-semibold text-ink">The service</h2>
          <p class="mt-2">
            Portfolio Builder is an AI-guided tool that helps you create a personal portfolio website.
            The service is currently free during the validation period.
          </p>
        </section>

        <section>
          <h2 class="font-display text-lg font-semibold text-ink">Your content</h2>
          <p class="mt-2">
            You own everything you create. Your text, images, and project data belong to you.
            You can export your portfolio at any time as a standalone static site.
          </p>
        </section>

        <section>
          <h2 class="font-display text-lg font-semibold text-ink">AI usage</h2>
          <p class="mt-2">
            The Guide AI uses your conversation content to help build your portfolio.
            Conversations are sent to third-party AI providers (via OpenRouter) for processing.
            We do not use your content to train AI models.
          </p>
        </section>

        <section>
          <h2 class="font-display text-lg font-semibold text-ink">Acceptable use</h2>
          <p class="mt-2">
            Don't use the service to host harmful, illegal, or deceptive content.
            We reserve the right to remove content that violates this policy.
          </p>
        </section>

        <section>
          <h2 class="font-display text-lg font-semibold text-ink">Availability</h2>
          <p class="mt-2">
            This is a pre-launch product. We may change, pause, or discontinue features.
            We'll give reasonable notice before making significant changes.
          </p>
        </section>

        <section>
          <h2 class="font-display text-lg font-semibold text-ink">Contact</h2>
          <p class="mt-2">
            Questions? Reach out at
            <a href="mailto:hello@portfoliobuilder.com" class="text-ink underline">hello@portfoliobuilder.com</a>.
          </p>
        </section>
      </div>
    </main>

    <footer class="mx-auto flex max-w-3xl items-center justify-between px-6 py-8">
      <span class="text-sm text-graphite">&copy; {new Date().getFullYear()} Portfolio Builder</span>
      <nav aria-label="Legal" class="flex gap-6 text-sm text-graphite">
        <a href="/privacy" class="transition-colors hover:text-ink">Privacy</a>
        <a href="/terms" class="text-ink font-medium">Terms</a>
      </nav>
    </footer>
  </body>
</html>
