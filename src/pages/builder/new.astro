---
// No server-side mutation. This page submits a form to POST /api/sites.
import "@fontsource-variable/outfit";
import "@fontsource-variable/lexend";
import "@/styles/app.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Creating portfolio...</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-cream font-body text-ink">
    <div class="text-center">
      <p class="text-sm text-graphite">Creating your portfolio...</p>
    </div>
    <script>
      (async () => {
        const res = await fetch('/api/sites', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        if (res.ok) {
          const { id } = await res.json();
          window.location.href = `/builder/${id}`;
        } else {
          window.location.href = '/dashboard';
        }
      })();
    </script>
  </body>
</html>
