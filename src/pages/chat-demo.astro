        <div class="text-center">
          <h1 class="font-display text-3xl font-bold text-ink">Chat Panel Demo</h1>
          <p class="mt-2 text-graphite">← The chat panel is on the left</p>
        </div>
      </main>
    </div>
  </body>
</html>
