{
  "name": "portfolio-builder",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build:tools": "tsx src/agents/tools/loader.ts",
    "predev": "pnpm run build:tools",
    "dev": "astro dev",
    "prebuild": "pnpm run build:tools",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply portfolio-builder-db --local",
    "db:regen": "rm -rf migrations .wrangler/state/v3/d1 && pnpm db:generate && pnpm db:migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/cloudflare": "^13.2.1",
    "@astrojs/svelte": "^8.0.5",
    "@fontsource-variable/lexend": "^5.2.11",
    "@fontsource-variable/outfit": "^5.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "astro": "^6.1.9",
    "better-auth": "^1.6.10",
    "better-auth-cloudflare": "^0.3.0",
    "bits-ui": "^2.18.0",
    "drizzle-orm": "^0.45.2",
    "markdown-it": "^14.1.1",
    "phosphor-svelte": "^3.1.0",
    "svelte": "^5.55.5",
    "svelte-sonner": "^1.1.1",
    "tailwindcss": "^4.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.7.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "svelte-check": "^4.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.85.0",
    "yaml": "^2.8.3"
  },
  "packageManager": "pnpm@9.15.4"
}
