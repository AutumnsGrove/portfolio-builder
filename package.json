{
  "name": "portfolio-builder",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "astro": "^6.1.9",
    "@astrojs/svelte": "^8.0.5",
    "@astrojs/cloudflare": "^13.2.1",
    "@astrojs/check": "^0.9.8",
    "svelte": "^5.55.5",
    "bits-ui": "^2.18.0",
    "tailwindcss": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "zod": "^4.3.6",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "svelte-check": "^4.4.6",
    "wrangler": "^4.85.0",
    "@cloudflare/workers-types": "^4.20260426.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "eslint": "^10.2.1",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.15.4"
}
